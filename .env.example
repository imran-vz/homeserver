# ===========================================
# Homeserver Environment Configuration
# ===========================================
# Copy this file to .env and fill in the required values.
#
# Legend:
#   [REQUIRED]  — You MUST set this before starting services.
#   [OPTIONAL]  — Has a sensible default; override only if needed.
# ===========================================


# ===========================================
# General
# ===========================================

# Timezone (used by most services)
# [OPTIONAL] Default: Asia/Kolkata
TZ=Asia/Kolkata


# ===========================================
# Tailscale Configuration
# ===========================================

# Auth key for Tailscale sidecars.
# Generate a reusable key at: https://login.tailscale.com/admin/settings/keys
# Tags (e.g. tag:container) must be defined in your Tailscale ACL policy first.
# [REQUIRED]
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxx

# Your Tailscale tailnet domain (found in Tailscale admin console → DNS).
# Used by setup.sh to configure Tailscale serve JSON configs.
# Format: your-tailnet-name.ts.net
# [REQUIRED]
TS_DOMAIN=your-tailnet.ts.net

# Image tag for all Tailscale sidecar containers.
# [OPTIONAL] Default: latest
TAILSCALE_VERSION=latest


# ===========================================
# Immich Configuration
# ===========================================

# Immich application version. Use 'release' for latest stable.
# [OPTIONAL] Default: release
IMMICH_VERSION=release

# PostgreSQL credentials for the Immich database.
# DB_PASSWORD has no default — you MUST set a strong password.
# [OPTIONAL] Default: immich
DB_USERNAME=immich
# [OPTIONAL] Default: immich
DB_DATABASE_NAME=immich
# [REQUIRED] Generate with: openssl rand -base64 32
DB_PASSWORD=changeme_use_strong_password


# ===========================================
# Zerobyte Configuration
# ===========================================

# Image tag for the Zerobyte container.
# [OPTIONAL] Default: latest
ZEROBYTE_VERSION=latest

# Application secret used by Zerobyte for signing / encryption.
# Generate with: openssl rand -base64 32
# [REQUIRED]
ZEROBYTE_APP_SECRET=changeme_generate_a_secret

# Base URL where Zerobyte is reachable (include https://).
# Example: https://zerobyte.your-tailnet.ts.net
# [REQUIRED]
ZEROBYTE_BASE_URL=https://zerobyte.your-tailnet.ts.net


# ===========================================
# Beszel Configuration (Server + Agent)
# ===========================================

# Image tag for the Beszel server (hub).
# [OPTIONAL] Default: latest
BESZEL_VERSION=latest

# Image tag for the Beszel agent.
# [OPTIONAL] Default: latest
BESZEL_AGENT_VERSION=latest

# Hub URL the agent connects to.
# This is shown in the Beszel web UI when you add a new system.
# [REQUIRED] (set after initial Beszel setup)
BESZEL_HUB=

# Agent token and public key — generated in the Beszel web UI
# when you add a system. Leave empty until you configure Beszel.
# [REQUIRED] (set after initial Beszel setup)
BESZEL_AGENT_TOKEN=
BESZEL_AGENT_KEY=


# ===========================================
# Tugtainer Configuration
# ===========================================

# Image tag for the Tugtainer container update dashboard.
# [OPTIONAL] Default: latest
TUGTAINER_VERSION=latest


# ===========================================
# Stirling PDF Configuration
# ===========================================

# Image tag for Stirling PDF.
# [OPTIONAL] Default: latest
STIRLING_PDF_VERSION=latest


# ===========================================
# Audiobookshelf Configuration
# ===========================================

# Image tag for Audiobookshelf.
# [OPTIONAL] Default: latest
AUDIOBOOKSHELF_VERSION=latest


# ===========================================
# AdGuard Home Configuration
# ===========================================

# Image tag for AdGuard Home.
# [OPTIONAL] Default: latest
ADGUARDHOME_VERSION=latest
